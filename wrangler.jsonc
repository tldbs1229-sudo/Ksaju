// Cloudflare Workers config: a static site served straight from the repo root.
// Files listed in .assetsignore (.git, .claude, CLAUDE.md, assets/ref, tools ...) are not published.
{
  "name": "ksaju",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "."
  },
  // branch builds run `wrangler preview`, which needs this block (it may stay empty)
  "previews": {}
}
